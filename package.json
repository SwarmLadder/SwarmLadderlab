{
  "name": "swarmladder-lab",
  "version": "1.0.0",
  "description": "Interactive SwarmLadder learning platform",
  "scripts": {
    "curriculum": "python build/prepare.py",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --mode staging",
    "test": "node --test tests/progress.test.ts",
    "test:e2e": "playwright test",
    "deploy:staging": "cf deploy --prebuilt --mode staging",
    "deploy:release": "vite build --mode release && cf deploy --prebuilt --mode release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwarmLadder/SwarmLadderlab.git"
  },
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/SwarmLadder/SwarmLadderlab/issues"
  },
  "homepage": "https://github.com/SwarmLadder/SwarmLadderlab#readme",
  "dependencies": {
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vinext/cloudflare": "^1.4.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.2",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vinext": "^1.4.6",
    "vite": "^8.3.8"
  },
  "private": true
}
